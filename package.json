{
  "name": "kantingo",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"pnpm --filter @kantingo/frontend dev\" \"cd backend && php artisan serve\"",
    "dev:frontend": "pnpm --filter @kantingo/frontend dev",
    "dev:backend": "cd backend && php artisan serve",
    "build": "pnpm --filter @kantingo/frontend build",
    "preview": "pnpm --filter @kantingo/frontend preview",
    "typecheck": "pnpm --filter @kantingo/frontend typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
